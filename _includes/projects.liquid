<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% else %}
        <div class="card-img-top d-flex align-items-center justify-content-center" style="height: 140px; background: var(--global-bg-color); font-size: 2rem; font-weight: 700; color: var(--global-theme-color); letter-spacing: 0.05em;">
          {{ project.title | split: ' ' | map: 'first' | join: '' | slice: 0, 3 | upcase }}
        </div>
      {% endif %}
      <div class="card-body" style="position: relative;">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.tags %}
          <div class="project-tags">
            {% assign tag_list = project.tags | split: "," %}
            {% for tag in tag_list %}
              <span class="project-tag">{{ tag | strip }}</span>
            {% endfor %}
          </div>
        {% endif %}
        <span class="list-item-hover-badge">↑</span>
        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
